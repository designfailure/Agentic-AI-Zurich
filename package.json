{
  "name": "mcp-scheme-ontology",
  "version": "1.0.0",
  "description": "MCP Scheme Ontology - Semantic inference framework for Model Context Protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "validate-schema": "ajv validate -s schemas/mcp-component-schema.json -d components/*.json",
    "example": "ts-node examples/inference-engine-example.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "semantic-inference",
    "ontology",
    "ai",
    "routing",
    "semantic-web",
    "linked-data"
  ],
  "author": "MCP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/designfailure/Agentic-AI-Zurich.git"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "ajv": "^8.12.0",
    "ajv-cli": "^5.0.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "types",
    "schemas",
    "ontology",
    "components",
    "inference-rules",
    "README.md",
    "ARCHITECTURE.md"
  ]
}
