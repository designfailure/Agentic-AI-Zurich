{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Inference Engine Specification",
  "description": "Specification for the MCP semantic inference engine that routes requests to appropriate components",
  "version": "1.0.0",
  "engine": {
    "id": "mcp-semantic-inference-engine",
    "name": "MCP Semantic Inference Engine",
    "version": "1.0.0",
    "description": "Core reasoning engine for semantic routing and component selection in MCP architecture"
  },
  "architecture": {
    "layers": [
      {
        "name": "Input Processing Layer",
        "order": 1,
        "components": [
          "request-parser",
          "intent-detector",
          "context-extractor",
          "embedding-generator"
        ],
        "responsibilities": [
          "Parse incoming requests",
          "Detect user intent",
          "Extract semantic context",
          "Generate query embeddings"
        ]
      },
      {
        "name": "Semantic Analysis Layer",
        "order": 2,
        "components": [
          "semantic-matcher",
          "keyword-analyzer",
          "domain-classifier",
          "confidence-scorer"
        ],
        "responsibilities": [
          "Perform semantic matching",
          "Analyze keywords",
          "Classify domain",
          "Calculate confidence scores"
        ]
      },
      {
        "name": "Inference Layer",
        "order": 3,
        "components": [
          "rule-engine",
          "component-selector",
          "dataset-selector",
          "tool-selector"
        ],
        "responsibilities": [
          "Apply inference rules",
          "Select optimal component",
          "Choose appropriate dataset",
          "Determine required tools"
        ]
      },
      {
        "name": "Routing Layer",
        "order": 4,
        "components": [
          "request-router",
          "parameter-mapper",
          "pipeline-orchestrator"
        ],
        "responsibilities": [
          "Route to selected component",
          "Map request parameters",
          "Orchestrate tool pipelines"
        ]
      }
    ]
  },
  "inferenceStrategy": {
    "type": "hybrid",
    "description": "Combines rule-based and ML-based inference for optimal component selection",
    "matchingAlgorithm": {
      "type": "combined",
      "stages": [
        {
          "stage": "exact-match",
          "description": "Check for exact pattern matches",
          "priority": 100,
          "methods": ["regex-pattern", "literal-match"]
        },
        {
          "stage": "rule-based-inference",
          "description": "Apply semantic inference rules",
          "priority": 80,
          "methods": ["intent-matching", "keyword-matching", "composite-rules"]
        },
        {
          "stage": "semantic-similarity",
          "description": "Calculate semantic similarity using embeddings",
          "priority": 60,
          "methods": ["cosine-similarity", "vector-search"],
          "parameters": {
            "embeddingModel": "text-embedding-3-large",
            "similarityThreshold": 0.75,
            "maxCandidates": 5
          }
        },
        {
          "stage": "fuzzy-matching",
          "description": "Fuzzy keyword and intent matching",
          "priority": 40,
          "methods": ["levenshtein-distance", "n-gram-similarity"],
          "parameters": {
            "threshold": 0.6
          }
        },
        {
          "stage": "fallback",
          "description": "Default component selection",
          "priority": 0,
          "methods": ["default-component"]
        }
      ]
    },
    "fallbackBehavior": {
      "strategy": "default",
      "defaultComponent": "general-purpose-component",
      "logUnmatchedRequests": true,
      "confidenceThreshold": 0.5
    }
  },
  "configuration": {
    "enableCaching": true,
    "cacheTTL": 3600,
    "cacheStrategy": "lru",
    "maxCacheSize": 10000,
    "enableLogging": true,
    "logLevel": "info",
    "maxInferenceDepth": 5,
    "parallelInference": true,
    "maxParallelRules": 10,
    "timeout": {
      "inferenceTimeout": 5000,
      "componentTimeout": 30000
    },
    "retryPolicy": {
      "maxRetries": 3,
      "backoffMultiplier": 2,
      "initialBackoffMs": 100
    }
  },
  "componentRegistry": {
    "description": "Registry of available MCP components",
    "components": [
      {
        "id": "database-query-component",
        "type": "source-module",
        "enabled": true,
        "priority": 10,
        "configPath": "../components/example-database-component.json"
      },
      {
        "id": "nlp-processing-component",
        "type": "source-module",
        "enabled": true,
        "priority": 10,
        "configPath": "../components/example-nlp-component.json"
      }
    ],
    "autoDiscovery": {
      "enabled": true,
      "scanPaths": ["./components"],
      "filePattern": "*.json"
    }
  },
  "ruleSet": {
    "description": "Semantic inference rules",
    "rulesPath": "../inference-rules/semantic-inference-rules.json",
    "customRulesEnabled": true,
    "ruleExecutionMode": "priority-ordered",
    "stopOnFirstMatch": false,
    "aggregateMultipleMatches": true,
    "aggregationStrategy": "weighted-average"
  },
  "semanticIndexing": {
    "enabled": true,
    "indexType": "vector",
    "embeddingModel": "text-embedding-3-large",
    "dimensions": 3072,
    "indexedFields": [
      "semanticContext.intents",
      "semanticContext.keywords",
      "semanticContext.concepts",
      "capabilities.name",
      "capabilities.description"
    ],
    "updateStrategy": "incremental",
    "rebuildInterval": 86400
  },
  "monitoring": {
    "enabled": true,
    "metrics": [
      {
        "name": "inference_latency",
        "type": "histogram",
        "unit": "ms"
      },
      {
        "name": "component_selection_accuracy",
        "type": "gauge",
        "unit": "percentage"
      },
      {
        "name": "rule_match_count",
        "type": "counter"
      },
      {
        "name": "cache_hit_rate",
        "type": "gauge",
        "unit": "percentage"
      },
      {
        "name": "confidence_scores",
        "type": "histogram"
      }
    ],
    "exporters": ["prometheus", "json-logs"]
  },
  "api": {
    "endpoints": [
      {
        "path": "/infer",
        "method": "POST",
        "description": "Main inference endpoint",
        "request": {
          "intent": "string (required)",
          "context": "object (optional)",
          "parameters": "object (optional)",
          "requiredCapabilities": "array (optional)"
        },
        "response": {
          "selectedComponent": "object",
          "confidence": "number",
          "reasoning": "string",
          "alternativeComponents": "array",
          "executionPlan": "object"
        }
      },
      {
        "path": "/components",
        "method": "GET",
        "description": "List all registered components",
        "response": {
          "components": "array",
          "count": "number"
        }
      },
      {
        "path": "/components/{id}",
        "method": "GET",
        "description": "Get component details",
        "response": {
          "component": "object"
        }
      },
      {
        "path": "/rules",
        "method": "GET",
        "description": "List all inference rules",
        "response": {
          "rules": "array",
          "categories": "array"
        }
      },
      {
        "path": "/evaluate",
        "method": "POST",
        "description": "Evaluate inference rules without execution",
        "request": {
          "intent": "string (required)",
          "context": "object (optional)"
        },
        "response": {
          "matchedRules": "array",
          "scores": "array",
          "recommendation": "object"
        }
      }
    ]
  },
  "executionFlow": {
    "description": "Standard execution flow for inference requests",
    "steps": [
      {
        "step": 1,
        "name": "Request Reception",
        "actions": [
          "Validate request format",
          "Extract intent and context",
          "Initialize inference session"
        ]
      },
      {
        "step": 2,
        "name": "Semantic Processing",
        "actions": [
          "Generate embeddings for query",
          "Detect intents using NLU",
          "Extract keywords and concepts",
          "Classify domain"
        ]
      },
      {
        "step": 3,
        "name": "Component Matching",
        "actions": [
          "Query component registry",
          "Apply inference rules",
          "Calculate semantic similarity",
          "Score candidate components"
        ]
      },
      {
        "step": 4,
        "name": "Selection & Validation",
        "actions": [
          "Select highest-scoring component",
          "Validate component availability",
          "Check confidence threshold",
          "Prepare alternative options"
        ]
      },
      {
        "step": 5,
        "name": "Dataset & Tool Selection",
        "actions": [
          "Apply dataset inference rules",
          "Select appropriate dataset",
          "Determine required tools",
          "Build tool execution pipeline"
        ]
      },
      {
        "step": 6,
        "name": "Execution Planning",
        "actions": [
          "Map request parameters to component API",
          "Generate execution plan",
          "Prepare routing instructions"
        ]
      },
      {
        "step": 7,
        "name": "Response Generation",
        "actions": [
          "Format inference response",
          "Include reasoning and alternatives",
          "Return execution plan"
        ]
      }
    ]
  },
  "extensibility": {
    "plugins": {
      "enabled": true,
      "types": [
        "custom-matchers",
        "custom-scorers",
        "custom-rules",
        "preprocessors",
        "postprocessors"
      ],
      "loadPath": "./plugins",
      "autoLoad": true
    },
    "hooks": {
      "preInference": "Optional hook before inference",
      "postInference": "Optional hook after inference",
      "onComponentSelection": "Optional hook when component is selected",
      "onError": "Optional hook on error"
    }
  }
}
